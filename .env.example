# GitHub OAuth Configuration
# Create a GitHub App at: https://github.com/settings/apps

# Your GitHub username
PUBLIC_GITHUB_OWNER=your-github-username

# Your repository name
PUBLIC_GITHUB_REPO=your-repo-name

# GitHub App OAuth Client ID
PUBLIC_GITHUB_CLIENT_ID=your-github-client-id

# Note: Client Secret should NOT be public
# Store it in your deployment platform's environment variables
GITHUB_CLIENT_SECRET=your-github-client-secret

# Optional: For local development, you might want to use a proxy
# PUBLIC_REDIRECT_URI=http://localhost:4321/admin
